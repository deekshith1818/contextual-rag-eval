data/raw_docs/*.txt
data/raw_docs/metadata.csv

# Processed chunks (can be regenerated)
data/processed/baseline_chunks.jsonl
data/processed/contextual_chunks.jsonl

# Eval results (large; generated by run_eval.py)
eval_set/results_baseline.jsonl
eval_set/results_contextual.jsonl

# Keep the eval question set and report in git
!eval_set/configmap_eval.jsonl
!eval_set/comparison_report.md

# Runtime observability query logs (generated by Phase 6 logger)
logs/

